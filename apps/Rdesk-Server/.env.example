RDESK_SERVER_HOST=0.0.0.0
RDESK_SERVER_PORT=9530
# Required. Supply a PostgreSQL URL with a separately managed, high-entropy
# password; do not commit the credential into this file.
RDESK_DB_URL=
# Required. Generate a high-entropy JWT secret (at least 32 bytes and 16
# distinct characters), and pin issuer/audience to this deployment.
RDESK_JWT_SECRET=
RDESK_JWT_ISSUER=
RDESK_JWT_AUDIENCE=
RDESK_JWT_EXPIRE_MINUTES=60
RDESK_JWT_MAX_LIFETIME_MINUTES=1440
RDESK_JWT_FUTURE_IAT_SKEW_SECONDS=60
# PBKDF2-SHA256 work factor. Production enforces at least 600000 iterations.
RDESK_PASSWORD_PBKDF2_ITERATIONS=600000
# Optional one-time bootstrap. Leave disabled after provisioning and inject the
# password from a secret manager when enabled; never place it in this file.
RDESK_BOOTSTRAP_ADMIN_ENABLED=false
RDESK_BOOTSTRAP_ADMIN_USERNAME=
RDESK_BOOTSTRAP_ADMIN_EMAIL=
RDESK_BOOTSTRAP_ADMIN_PASSWORD=
RDESK_SIGNALING_WS_URL=ws://127.0.0.1:9532/ws
RDESK_REALTIME_SERVER_HEALTH_URL=http://127.0.0.1:9532/health
RDESK_REALTIME_SERVER_COMMAND=cargo
RDESK_REALTIME_SERVER_ARGS=run -p realtime-server --manifest-path G:/Project/mini-remote-desktop/Cargo.toml
RDESK_REALTIME_SERVER_WORKDIR=G:/Project/mini-remote-desktop
RDESK_CORS_ORIGINS=http://localhost:9531,http://127.0.0.1:9531
# The legacy global TURN endpoint is disabled by default. It is development-only
# because callers used to supply the authorization deadline themselves.
RDESK_TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp,turns:127.0.0.1:5349?transport=tcp
RDESK_TURN_AUTH_SECRET=
RDESK_TURN_CREDENTIAL_TTL_SECONDS=600
RDESK_LEGACY_TURN_CREDENTIALS_ENABLED=false
# Required for relay access. Both values are base64-encoded 32-byte keys injected
# from a secret manager. Rotation changes the explicit key IDs.
RDESK_RELAY_DIRECTORY_TTL_SECONDS=30
RDESK_RELAY_DIRECTORY_SIGNING_KEY_ID=
RDESK_RELAY_DIRECTORY_SIGNING_PRIVATE_KEY=
RDESK_RELAY_TURN_SECRET_ENCRYPTION_KEY_ID=active
RDESK_RELAY_TURN_SECRET_ENCRYPTION_KEY=
# Relay node APIs remain disabled until this private-hop allowlist is set.
# Run Uvicorn with proxy_headers disabled. The listed mTLS proxy must strip all
# Forwarded/X-Forwarded-* and relay authentication headers from client traffic.
RDESK_TRUSTED_MTLS_PROXY=
# Maximum accepted signed-request clock skew (seconds).
RDESK_RELAY_MAX_CLOCK_SKEW_SECONDS=30
# Required 32-byte-or-longer random pepper, encoded as hexadecimal.
RDESK_RELAY_ENROLLMENT_TOKEN_PEPPER=
# PEM values and the optional encrypted-key password must be injected as
# secrets. The CA certificate is public but still deployment-specific.
RDESK_RELAY_CA_CERTIFICATE_PEM=
RDESK_RELAY_CA_PRIVATE_KEY_PEM=
RDESK_RELAY_CA_PRIVATE_KEY_PASSWORD=
# Leaf validity and renewal window in seconds. Agents renew before expiry; a
# certificate is issued only during the first fresh enrollment pickup.
RDESK_RELAY_CERTIFICATE_VALIDITY_SECONDS=3600
RDESK_RELAY_CERTIFICATE_RENEW_BEFORE_SECONDS=3600
# Enrollment delivery receipts expire immutably after this many seconds.
RDESK_RELAY_ENROLLMENT_RECEIPT_TTL_SECONDS=86400
# Previous-certificate generic grace is intentionally separate from exact
# renewal retry idempotency. Exact retries remain bounded by certificate expiry
# and the retained renewal record.
RDESK_RELAY_PREVIOUS_AUTH_GRACE_SECONDS=300
RDESK_RELAY_RENEWAL_RECORD_RETENTION_SECONDS=86400
